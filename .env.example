# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Any Postgres. The app is coupled to nothing but this URL, so it moves between
# Prisma Postgres, Supabase, Neon or RDS by changing this one value.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Signs session cookies. At least 32 characters, and DIFFERENT per environment.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# Public origin of the deployment.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------

# Guards POST /api/admin/migrate. Without it, that endpoint is disabled entirely.
ADMIN_SECRET=""

# Guards the scheduled jobs under /api/cron/*.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Optional — AI
# ---------------------------------------------------------------------------
# Without a key the app uses the `heuristic` provider, which genuinely parses
# CSV, Excel and text PDFs and categorises from the merchant lexicon and your
# own rules. Images, scanned PDFs and video frames need a vision model.

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="auto"        # auto | anthropic | openai | heuristic

# ---------------------------------------------------------------------------
# Optional — file storage
# ---------------------------------------------------------------------------
# `postgres` (default) keeps uploaded files in the database, served only through
# an authenticated, workspace-scoped route. No public bucket, no guessable URL.

STORAGE_DRIVER="postgres"   # postgres | supabase | vercel_blob
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="pockit-files"
BLOB_READ_WRITE_TOKEN=""

MAX_UPLOAD_MB="8"
