# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Any Postgres. The app is coupled to nothing but this URL, so it moves between
# Prisma Postgres, Supabase, Neon or RDS by changing this one value.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Signs session cookies. At least 32 characters, and DIFFERENT per environment.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# Public origin of the deployment.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------

# Guards POST /api/admin/migrate. Without it, that endpoint is disabled entirely.
ADMIN_SECRET=""

# Guards the scheduled jobs under /api/cron/*.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Optional — AI
# ---------------------------------------------------------------------------
# Without a key the app uses the `heuristic` provider, which genuinely parses
# CSV, Excel and text PDFs and categorises from the merchant lexicon and your
# own rules. Images, scanned PDFs and video frames need a vision model.

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="auto"        # auto | anthropic | openai | heuristic

# ---------------------------------------------------------------------------
# Optional — file storage
# ---------------------------------------------------------------------------
# `postgres` (default) keeps uploaded files in the database, served only through
# an authenticated, workspace-scoped route. No public bucket, no guessable URL.

STORAGE_DRIVER="postgres"   # postgres | supabase | vercel_blob
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="pockit-files"
BLOB_READ_WRITE_TOKEN=""

MAX_UPLOAD_MB="8"

# Market data for the investing section. Without either key, prices are
# clearly-labelled sample data and every other part of the feature still works.
#
# Twelve Data is the one to set. It is checked first, and its free tier is the only
# one here that serves historical candles — which is to say, the only one that makes
# the charts work. It also powers search across the whole instrument universe rather
# than the ~69 in the shipped catalogue.
# Free key: https://twelvedata.com/pricing (800 requests/day, 8/minute)
TWELVEDATA_API_KEY=

# Finnhub still works if you already have a key, but its free plan puts historical
# candles behind payment, so charts will read as unavailable.
FINNHUB_API_KEY=

# Pockit Plus. Off until you launch it: everyone gets everything, no paywall.
PLUS_ENABLED=false
# RevenueCat → Integrations → Webhooks → Authorization header value (any long random string).
REVENUECAT_WEBHOOK_SECRET=

# Your email (comma-separate several). Admins always have Plus and see the app's Developer screen.
ADMIN_EMAILS=

# Plan a trip: Google Maps Platform key with "Places API (New)" and "Routes API" enabled.
# Optional — without it, trips use free OpenStreetMap search and routing.
GOOGLE_MAPS_API_KEY=

# Bank connection (Plaid). dashboard.plaid.com → Developers → Keys. PLAID_ENV is sandbox until Plaid approves production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
