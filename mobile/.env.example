# Where the Pockit server lives. For your deployed site use its https URL.
# On a real iPhone, "localhost" means the phone itself — use your computer's
# local network address instead (e.g. http://192.168.1.20:3000) when testing locally.
EXPO_PUBLIC_API_URL=https://your-pockit-site.vercel.app

# 1 = show every screen with sample figures and no server (design review only).
EXPO_PUBLIC_PREVIEW=0
