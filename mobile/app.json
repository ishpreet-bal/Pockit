{
  "expo": {
    "name": "Pockit",
    "slug": "pockit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pockit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ishpreetbal.pockit",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Pockit uses Face ID to keep your money private when you open the app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6d4aff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fbfbfd",
          "dark": {
            "backgroundColor": "#0f0e14"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pockit uses Face ID to keep your money private when you open the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6d4aff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
