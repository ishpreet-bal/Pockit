{
  "name": "pockit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "config:check": "node scripts/check-config.mjs",
    "build": "next build",
    "build:app-web": "node scripts/build-app-web.mjs",
    "vehicles:update": "node scripts/update-vehicles.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "node e2e/smoke.mjs",
    "e2e:polish": "node e2e/polish.mjs",
    "e2e:trip-investing": "node e2e/trip-investing.mjs",
    "e2e:setup": "node e2e/setup.mjs",
    "e2e:ui": "node e2e/ui.mjs",
    "e2e:wizard": "node e2e/wizard.mjs",
    "e2e:onboarding": "node e2e/onboarding.mjs",
    "e2e:investing": "node e2e/investing.mjs",
    "db:start": "bash scripts/dev-db.sh",
    "e2e:security": "node e2e/security.mjs",
    "e2e:bank": "node e2e/bank.mjs",
    "e2e:friends": "node e2e/friends.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.550.0",
    "nanoid": "^6.0.1",
    "next": "15.5.25",
    "openai": "^7.30.1",
    "papaparse": "5.7.0",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
